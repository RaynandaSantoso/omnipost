#!/bin/zsh
set -eu

project_dir="$(cd "$(dirname "$0")/../../../.." && pwd)"

/usr/bin/osascript - "$project_dir" <<'APPLESCRIPT'
on run argv
  set projectDirectory to item 1 of argv
  tell application "Terminal"
    do script "cd " & quoted form of projectDirectory & " && npm run launch"
    activate
  end tell
end run
APPLESCRIPT
