// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Single-tenant app: one seeded row. Kept as a real table (rather than a
// hardcoded constant) so every domain table can carry a user_id and later
// multi-user support is additive, not a schema rewrite.
model User {
  id                  String               @id @default(cuid())
  createdAt           DateTime             @default(now())
  uploads             Upload[]
  platformConnections PlatformConnection[]
  oauthStates         OAuthState[]
}

// A connected platform account. Tokens are AES-256-GCM ciphertexts, never
// plaintext; the crypto module owns their encoding and decryption.
model PlatformConnection {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id])
  platform             String
  accessTokenEncrypted String
  refreshTokenEncrypted String
  accessTokenExpiresAt DateTime
  channelId            String
  refreshError         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([userId, platform])
}

// Short-lived, server-side OAuth CSRF state. It is consumed atomically by
// the callback and is bound to the exact redirect URI configured by the
// operator.
model OAuthState {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  value       String   @unique
  redirectUri String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([expiresAt])
}

// One user-initiated publish action: the source video plus the shared
// title/description used across every platform it fans out to.
model Upload {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  title       String
  description String
  fileName    String
  filePath    String
  fileSize    Int
  createdAt   DateTime @default(now())
  jobs        Job[]
}

// One unit of background work: one upload to one platform. v0.1 fans out
// to exactly one (dry-run) Job per Upload; real multi-platform fan-out
// arrives with the YouTube/TikTok/Instagram adapters.
model Job {
  id        String   @id @default(cuid())
  uploadId  String
  upload    Upload   @relation(fields: [uploadId], references: [id])
  platform  String
  status    String   @default("pending")
  resultUrl String?
  error     String?
  // Retry bookkeeping. attempts counts claims, not failures, so a worker
  // that crashes mid-upload burns an attempt too and a poisoned job can
  // never be reclaimed forever.
  attempts      Int       @default(0)
  nextAttemptAt DateTime?
  // Lease: which worker holds this job and until when. An expired lease is
  // what makes a job reclaimable after a crash, rather than stuck.
  leaseOwner     String?
  leaseExpiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextAttemptAt])
}
