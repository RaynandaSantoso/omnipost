# Copy this file to .env and fill in real values before running
# `docker compose up` or `npm run dev`. Never commit the real .env file.

# SQLite connection string. Must be a `file:` URL. Resolved relative to the
# app's working directory when relative (docker-compose already points this
# at the mounted /app/data volume via the Dockerfile default — you only
# need to set this for local, non-Docker development).
DATABASE_URL="file:./data/dev.db"

# Shared-password access gate. It may be left unset (or blank) only for a
# purely local run. PUBLIC_BASE_URL requires a non-empty password at boot.
# When set, every route requires this password before granting access; it
# is not a per-user account system, just a gate. See the README for how
# the resulting session works.
# ACCESS_PASSWORD=""

# Job engine policy. All optional — the defaults shown are what the app uses
# when they're unset, and are sensible for a single-user instance.
#
# How many attempts a job gets before it stops and waits for you. A crashed
# worker burns an attempt too, so a job that reliably kills the process can
# never loop forever.
# JOB_MAX_ATTEMPTS="5"
# How long a worker's claim on a job stays valid without a heartbeat. Longer
# than any pause you expect mid-upload; shorter is faster crash recovery.
# JOB_LEASE_MS="30000"
# Retry backoff: the first delay, doubling per attempt, capped. The actual
# delay is jittered around this so retries don't synchronise into a burst.
# JOB_BACKOFF_BASE_MS="1000"
# JOB_BACKOFF_MAX_MS="300000"

# YouTube OAuth. Create an OAuth 2.0 Web application in your own Google
# Cloud project and publish its consent screen to Production (not Testing,
# whose refresh tokens expire after seven days). The redirect URI must match
# this value exactly in both Google Cloud and the app.
# YOUTUBE_CLIENT_ID=""
# YOUTUBE_CLIENT_SECRET=""
# YOUTUBE_REDIRECT_URI="https://omnipost.example.com/api/platforms/youtube/callback"
# Encrypts platform credentials and signs expiring public media URLs. Base64
# of exactly 32 random bytes; e.g. openssl rand -base64 32.
# TOKEN_ENCRYPTION_KEY=""

# Shared public origin. Install and authenticate ngrok, then use one assigned
# HTTPS origin here. `npm run dev` and the production Launcher start exactly
# one tunnel. ACCESS_PASSWORD is required whenever this is set.
# PUBLIC_BASE_URL="https://your-domain.ngrok-free.dev"

# TikTok OAuth. Register this exact callback in TikTok Login Kit. Its origin
# must exactly match PUBLIC_BASE_URL.
# TIKTOK_CLIENT_KEY=""
# TIKTOK_CLIENT_SECRET=""
# TIKTOK_REDIRECT_URI="https://your-domain.ngrok-free.dev/api/platforms/tiktok/callback"

# Instagram OAuth, via Instagram API with Instagram Login. Add the Instagram
# use case to a Meta developer app and register this exact callback under it.
# The callback's origin must exactly match PUBLIC_BASE_URL.
#
# These are the *Instagram* app id and secret, from that use case's own
# settings card — not the Facebook app id and secret shown on the app
# dashboard. The two are different values and the Facebook pair will not
# authenticate here. No Facebook Page is involved: the Instagram account only
# has to be a Business or Creator account.
# INSTAGRAM_APP_ID=""
# INSTAGRAM_APP_SECRET=""
# INSTAGRAM_REDIRECT_URI="https://your-domain.ngrok-free.dev/api/platforms/instagram/callback"
