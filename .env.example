# Copy this file to .env and fill in real values before running
# `docker compose up` or `npm run dev`. Never commit the real .env file.

# SQLite connection string. Must be a `file:` URL. Resolved relative to the
# app's working directory when relative (docker-compose already points this
# at the mounted /app/data volume via the Dockerfile default — you only
# need to set this for local, non-Docker development).
DATABASE_URL="file:./data/dev.db"

# Optional shared-password access gate. Leave unset (or blank) to run the
# app open with no login — the right choice for a purely local install.
# When set, every route requires this password before granting access; it
# is not a per-user account system, just a gate. See the README for how
# the resulting session works.
# ACCESS_PASSWORD=""
